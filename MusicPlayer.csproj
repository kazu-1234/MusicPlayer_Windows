<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>MusicPlayer</RootNamespace>
    <AssemblyName>MusicPlayer</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WindowsPackageType>None</WindowsPackageType>
    <ApplicationDefaultLanguage>ja-JP</ApplicationDefaultLanguage>
    <Version>1.2.0</Version>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <DefineConstants>DISABLE_XAML_GENERATED_MAIN;DISABLE_XAML_GENERATED_BREAK_ON_UNHANDLED_EXCEPTION</DefineConstants>
  </PropertyGroup>
  <!-- exe 自体のアイコン（エクスプローラー・タスクバー）。Android 版と同じ白地に黒い音符（scripts\make-app-icon.ps1 で作成） -->
  <PropertyGroup Condition="Exists('Assets\AppIcon.ico')">
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- アイコンを Assets/AppIcon.ico に配置すると自動でコピーされる（未配置でも既定表示で動作する） -->
    <Content Include="Assets\AppIcon.ico" Condition="Exists('Assets\AppIcon.ico')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- タスクバーのプレビューのボタン用アイコン（scripts\make-thumb-icons.ps1 で作成） -->
    <Content Include="Assets\Thumb*.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!--
      ffmpeg は scripts\fetch-ffmpeg.ps1 で ThirdParty\ffmpeg\ に取得する（git 管理外）。
      存在するときだけ出力フォルダの ffmpeg\ 以下へコピーし、変換・CD 取り込みで使う。
    -->
    <None Include="ThirdParty\ffmpeg\**\*" Condition="Exists('ThirdParty\ffmpeg\ffmpeg.exe')">
      <Link>ffmpeg\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.250402" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.0.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- 共通ライブラリはテンプレート側を参照する（ARCHITECTURE.md 6 章：複製後も Template の Shared を参照） -->
    <ProjectReference Include="..\WinUiAppTemplate\Shared\WinUiShared.csproj" />
  </ItemGroup>
  <!--
    unpackaged（WindowsPackageType=None）の dotnet publish では、XAML をコンパイルした .xbf（App / MainWindow / 各ページ）と
    MusicPlayer.pri が出力に入らず、インストールしたアプリが起動直後にクラッシュする（XAML を読めない）。
    ビルド出力にあるこれらを publish の対象に加える。
  -->
  <Target Name="IncludeXamlOutputsInPublish" BeforeTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_XamlOutput Include="$(OutDir)**\*.xbf;$(OutDir)MusicPlayer.pri" />
      <ResolvedFileToPublish Include="@(_XamlOutput)" RelativePath="%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
