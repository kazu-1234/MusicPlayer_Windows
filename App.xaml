<Application
    x:Class="MusicPlayer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MusicPlayer"
    xmlns:views="using:MusicPlayer.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- コンテンツ最大幅（BlueShift / Auto Dark Mode と同値） -->
            <x:Double x:Key="PageContentMaxWidth">1000</x:Double>
            <x:Double x:Key="SettingsCardSpacing">4</x:Double>
            <x:Double x:Key="ControlRowSpacing">12</x:Double>

            <Style x:Key="PageHostScrollViewerStyle" TargetType="ScrollViewer">
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                <!-- Auto: 内容が収まるときはバーが出ず、はみ出すときだけ出る。
                     Disabled にすると内容の高さが画面の高さに押さえ込まれ、設定画面が見切れてもスクロールできなくなる -->
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
            </Style>

            <Style x:Key="PageBaseStackPanelStyle" TargetType="StackPanel">
                <Setter Property="MaxWidth" Value="{StaticResource PageContentMaxWidth}" />
                <Setter Property="Margin" Value="24,0,24,24" />
                <Setter Property="Spacing" Value="{StaticResource SettingsCardSpacing}" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>

            <Style x:Key="PageTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,20,0,12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="CardHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="CardDescriptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="SettingsSectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeaderStyle}">
                <Setter Property="Margin" Value="0,28,0,4" />
            </Style>

            <Style x:Key="SettingsSectionHeaderFirstStyle" TargetType="TextBlock" BasedOn="{StaticResource SettingsSectionHeaderStyle}">
                <Setter Property="Margin" Value="0,8,0,4" />
            </Style>

            <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>

            <!-- テーマ ComboBox: 右端位置は維持。文字左右余白は Padding、幅は CompactComboBoxHelper -->
            <Style x:Key="CompactComboBoxThemeStyle" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
                <Setter Property="Padding" Value="12,2,0,2" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
            </Style>
            <!-- ───────── 音楽プレーヤー用 ───────── -->

            <views:TimeTooltipConverter x:Key="TimeTooltipConverter" />

            <!-- 一覧ページ（ライブラリ・プレイリストなど）の外側余白。スクロールは一覧自体が持つ -->
            <Thickness x:Key="ListPageMargin">24,0,24,0</Thickness>

            <!-- 再生バーなどの枠なしアイコンボタン -->
            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="20" />
            </Style>

            <Style x:Key="IconToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="20" />
            </Style>

            <!-- 中央の大きな再生／一時停止ボタン -->
            <Style x:Key="PlayButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Width" Value="48" />
                <Setter Property="Height" Value="48" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="24" />
            </Style>

            <!-- 曲一覧の補助列（アーティスト・アルバム・時間など）の文字 -->
            <Style x:Key="ListSecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="ListPrimaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- 曲一覧 1 行の高さ・行ジャケットの列幅。値の正本は AppConfig（App のコンストラクターで上書きする） -->
            <x:Double x:Key="TrackRowHeight">52</x:Double>
            <GridLength x:Key="TrackRowArtColumnWidth">40</GridLength>

            <!-- 曲一覧の行の入れ物。左右の余白は TrackRowBorderStyle 側で取る（区切り線を行の端まで引くため 0 にする） -->
            <Style x:Key="TrackListItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>

            <!-- 曲一覧の 1 行: 下端に薄い区切り線を引き、曲と曲の境目を見やすくする（WMP と同じ見た目）。
                 ListViewItem 自体の枠線は既定のテンプレートが描かないので、行テンプレートの外側の Border で描く -->
            <Style x:Key="TrackRowBorderStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="Padding" Value="12,0,12,0" />
            </Style>

            <!-- アルバム・アーティスト一覧の頭文字の見出し（&amp; / A / か / 漢字 など）。WMP と同じくアクセント色 -->
            <DataTemplate x:Key="LetterGroupHeaderTemplate">
                <TextBlock Text="{Binding Key}" FontSize="20" Margin="0,8,0,0"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </DataTemplate>

            <!-- 曲一覧の見出し（押すとその列で並べ替え）。目立たせず、文字は補助色・左寄せ -->
            <Style x:Key="ColumnHeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0,4" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- ジャケットが無いときの背景 -->
            <Style x:Key="ArtPlaceholderBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
