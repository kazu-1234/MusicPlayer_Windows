<UserControl
    x:Class="MusicPlayer.Controls.PlayerBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MusicPlayer.Controls"
    Loaded="UserControl_Loaded"
    Unloaded="UserControl_Unloaded">
    <!-- メディア プレーヤー（新）風: 上段にシークバー、下段に 曲情報 / 操作ボタン / 音量 -->
    <Grid x:Name="RootPanel"
          Background="{ThemeResource LayerFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="0,1,0,0"
          Padding="16,4,16,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 上段: 経過時間 / シークバー / 曲の長さ -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PositionText" Text="0:00" VerticalAlignment="Center" MinWidth="40"
                       Style="{StaticResource CaptionTextBlockStyle}" />
            <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="1" StepFrequency="0.1"
                    IsEnabled="False" VerticalAlignment="Center"
                    ThumbToolTipValueConverter="{StaticResource TimeTooltipConverter}"
                    ValueChanged="SeekSlider_ValueChanged" />
            <TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00" VerticalAlignment="Center" MinWidth="40"
                       TextAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <!-- 下段 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左: ジャケット + 曲名 / アーティスト（クリックで再生中画面へ） -->
            <Button x:Name="NowPlayingButton" Background="Transparent" BorderThickness="0" Padding="0"
                    HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                    Click="NowPlayingButton_Click">
                <StackPanel x:Name="TrackInfoPanel" Orientation="Horizontal">
                    <!-- ジャケットの大きさ・角丸・文字サイズはコードビハインドで AppConfig の値を設定する -->
                    <Grid x:Name="ArtHost">
                        <Border x:Name="ArtPlaceholder" Style="{StaticResource ArtPlaceholderBorderStyle}">
                            <FontIcon Glyph="&#xEC4F;" FontSize="20" Opacity="0.6" />
                        </Border>
                        <Border x:Name="ArtClip">
                            <Image x:Name="ArtImage" Stretch="UniformToFill" />
                        </Border>
                    </Grid>
                    <StackPanel x:Name="TrackTextPanel" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <!-- 2 行目「アーティスト • アルバム」。名前を押すとそのページへ（曲名・ジャケットを押すと従来どおり再生中画面へ） -->
                        <local:ArtistAlbumLine x:Name="ArtistAlbum" HorizontalAlignment="Left" />
                    </StackPanel>
                </StackPanel>
            </Button>

            <!-- 中央: シャッフル / 前へ / 再生 / 次へ / リピート -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ToggleButton x:Name="ShuffleButton" Style="{StaticResource IconToggleButtonStyle}"
                              Click="ShuffleButton_Click">
                    <FontIcon Glyph="&#xE8B1;" FontSize="16" />
                </ToggleButton>
                <Button x:Name="PreviousButton" Style="{StaticResource IconButtonStyle}" Click="PreviousButton_Click">
                    <FontIcon Glyph="&#xE892;" FontSize="16" />
                </Button>
                <Button x:Name="PlayPauseButton" Style="{StaticResource PlayButtonStyle}"
                        Click="PlayPauseButton_Click">
                    <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="18" />
                </Button>
                <Button x:Name="NextButton" Style="{StaticResource IconButtonStyle}" Click="NextButton_Click">
                    <FontIcon Glyph="&#xE893;" FontSize="16" />
                </Button>
                <ToggleButton x:Name="RepeatButton" Style="{StaticResource IconToggleButtonStyle}"
                              Click="RepeatButton_Click">
                    <FontIcon x:Name="RepeatIcon" Glyph="&#xE8EE;" FontSize="16" />
                </ToggleButton>
            </StackPanel>

            <!-- 右: 音量 -->
            <!-- マウスホイールでも音量を変えられる。Background=Transparent は隙間の上でもホイールを受け取るため -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" PointerWheelChanged="VolumePanel_PointerWheelChanged">
                <Button x:Name="MuteButton" Style="{StaticResource IconButtonStyle}" Click="MuteButton_Click">
                    <FontIcon x:Name="VolumeIcon" Glyph="&#xE767;" FontSize="16" />
                </Button>
                <Slider x:Name="VolumeSlider" Width="120" Minimum="0" Maximum="100" StepFrequency="1"
                        VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
