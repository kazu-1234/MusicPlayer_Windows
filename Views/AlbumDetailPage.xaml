<Page
    x:Class="MusicPlayer.Views.AlbumDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MusicPlayer.Models"
    xmlns:controls="using:MusicPlayer.Controls">
    <Page.Resources>
        <!-- ヘッダーのアーティスト名（大きめ・薄い色） -->
        <Style x:Key="DetailArtistTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Page.Resources>
    <Grid Margin="{StaticResource ListPageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ヘッダー: ジャケット / アルバム名 / アーティスト / 年・形式・曲数 / 操作ボタン -->
        <Grid Margin="0,20,0,16" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="ArtHost">
                <Border Style="{StaticResource ArtPlaceholderBorderStyle}">
                    <FontIcon Glyph="&#xE93C;" FontSize="56" Opacity="0.5" />
                </Border>
                <Border CornerRadius="6">
                    <Image x:Name="ArtImage" Stretch="UniformToFill" />
                </Border>
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="4">
                <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                <!-- アルバムのアーティスト名。押すとそのアーティストのページへ -->
                <controls:LinkText x:Name="ArtistText" TextStyle="{StaticResource DetailArtistTextStyle}" Click="HeaderArtist_Click" />
                <TextBlock x:Name="InfoText" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource ControlRowSpacing}" Margin="0,12,0,0">
                    <Button Style="{StaticResource AccentButtonStyle}" Click="PlayButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                            <TextBlock x:Uid="Detail_PlayAll" />
                        </StackPanel>
                    </Button>
                    <Button Click="ShuffleButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                            <TextBlock x:Uid="Detail_Shuffle" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="MoreButton">
                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- 見出し（上）と一覧（下）。見出しは一覧の外に置くので、スクロールしても上に残る -->
        <Grid x:Name="TracksPanel" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- 見出し: 押すとその列で並べ替え（もう一度押すと昇順／降順を切り替え）。列幅は一覧の行と同じにする -->
            <Grid x:Name="TracksHeader" Padding="12,0,12,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource TrackRowArtColumnWidth}" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="56" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Tag="TrackNumber" Style="{StaticResource ColumnHeaderButtonStyle}">
                    <TextBlock x:Uid="Column_Number" Style="{StaticResource ListSecondaryTextStyle}" />
                </Button>
                <Button Grid.Column="2" Tag="Name" Style="{StaticResource ColumnHeaderButtonStyle}">
                    <TextBlock x:Uid="Column_Title" Style="{StaticResource ListSecondaryTextStyle}" />
                </Button>
                <Button Grid.Column="3" Tag="Artist" Style="{StaticResource ColumnHeaderButtonStyle}">
                    <TextBlock x:Uid="Column_Artist" Style="{StaticResource ListSecondaryTextStyle}" />
                </Button>
                <Button Grid.Column="4" Tag="Added" Style="{StaticResource ColumnHeaderButtonStyle}">
                    <TextBlock x:Uid="Column_Added" Style="{StaticResource ListSecondaryTextStyle}" />
                </Button>
                <Button Grid.Column="5" Tag="Duration" Style="{StaticResource ColumnHeaderButtonStyle}">
                    <TextBlock x:Uid="Column_Time" Style="{StaticResource ListSecondaryTextStyle}" />
                </Button>
            </Grid>
            <ListView x:Name="TracksList" Grid.Row="1" ItemContainerStyle="{StaticResource TrackListItemStyle}" SelectionMode="Extended"
                      IsDoubleTapEnabled="True" DoubleTapped="TracksList_DoubleTapped">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- KeepScrollOffset: 並べ替えで項目が動いてもスクロール位置を変えない（既定だと少し下へずれる） -->
                        <ItemsStackPanel ItemsUpdatingScrollMode="KeepScrollOffset" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Track">
                        <Border Style="{StaticResource TrackRowBorderStyle}">
                            <Grid ColumnSpacing="12" Height="{StaticResource TrackRowHeight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource TrackRowArtColumnWidth}" />
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <!-- 左端: 曲のジャケット（表示された行だけ非同期で読み込む） -->
                                <controls:TrackArt TrackPath="{x:Bind Path}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind TrackNumberText}" Style="{StaticResource ListSecondaryTextStyle}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="2" Text="{x:Bind DisplayTitle}" Style="{StaticResource ListPrimaryTextStyle}" />
                                <controls:LinkText Grid.Column="3" Text="{x:Bind DisplayArtist}" TextStyle="{StaticResource ListSecondaryTextStyle}" Click="ArtistLink_Click" />
                                <TextBlock Grid.Column="4" Text="{x:Bind AddedText}" Style="{StaticResource ListSecondaryTextStyle}" />
                                <TextBlock Grid.Column="5" Text="{x:Bind DurationText}" Style="{StaticResource ListSecondaryTextStyle}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
