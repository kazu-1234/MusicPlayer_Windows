<Page
    x:Class="MusicPlayer.Views.ConvertPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MusicPlayer.Views"
    NavigationCacheMode="Required">
    <Grid Margin="{StaticResource ListPageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Uid="Page_Convert" Style="{StaticResource PageTitleTextStyle}" />

        <InfoBar x:Name="FfmpegBar" Grid.Row="1" x:Uid="Convert_FfmpegMissingBar" Severity="Warning"
                 IsOpen="False" IsClosable="False" Margin="0,0,0,8" />

        <!-- 出力設定: 形式 / 品質 / 出力先 -->
        <Grid Grid.Row="2" ColumnSpacing="{StaticResource ControlRowSpacing}" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="FormatCombo" x:Uid="Convert_Format" MinWidth="150" SelectionChanged="FormatCombo_SelectionChanged" />
            <ComboBox x:Name="PresetCombo" x:Uid="Convert_Quality" Grid.Column="1" MinWidth="200" SelectionChanged="PresetCombo_SelectionChanged" />
            <TextBox x:Name="OutputBox" x:Uid="Convert_Output" Grid.Column="2" IsReadOnly="True" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <Button x:Uid="Common_Browse" Click="BrowseButton_Click" />
                <Button x:Name="SameFolderButton" x:Uid="Convert_SameFolder" Click="SameFolderButton_Click" />
            </StackPanel>
        </Grid>

        <!-- ファイル操作 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="{StaticResource ControlRowSpacing}" Margin="0,0,0,8">
            <Button Click="AddFilesButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                    <TextBlock x:Uid="Tag_AddFiles" />
                </StackPanel>
            </Button>
            <Button Click="AddFolderButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                    <TextBlock x:Uid="Tag_AddFolder" />
                </StackPanel>
            </Button>
            <Button x:Name="ClearButton" Click="ClearButton_Click">
                <FontIcon Glyph="&#xE894;" FontSize="14" />
            </Button>
        </StackPanel>

        <ListView x:Name="ItemsList" Grid.Row="4" SelectionMode="None"
                  BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="6"
                  AllowDrop="True" DragOver="ItemsList_DragOver" Drop="ItemsList_Drop">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:ConvertItem">
                    <Grid ColumnSpacing="12" Padding="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind FileName}" Style="{StaticResource ListPrimaryTextStyle}" />
                            <TextBlock Text="{x:Bind Folder}" Style="{StaticResource ListSecondaryTextStyle}" FontSize="12" />
                        </StackPanel>
                        <ProgressBar Grid.Column="1" Value="{x:Bind Progress, Mode=OneWay}" Maximum="100" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Status, Mode=OneWay}" Style="{StaticResource ListSecondaryTextStyle}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock x:Name="EmptyText" Grid.Row="4" x:Uid="Convert_Empty" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="{StaticResource ControlRowSpacing}" Margin="0,12,0,16">
            <Button x:Name="StartButton" Style="{StaticResource PrimaryActionButtonStyle}" Click="StartButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                    <TextBlock x:Uid="Convert_Start" />
                </StackPanel>
            </Button>
            <Button x:Name="CancelButton" x:Uid="Button_Cancel" IsEnabled="False" Click="CancelButton_Click" />
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
        </StackPanel>
    </Grid>
</Page>
