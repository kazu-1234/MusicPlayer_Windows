<Page
    x:Class="MusicPlayer.Views.PlaylistDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MusicPlayer.Models"
    xmlns:controls="using:MusicPlayer.Controls">
    <Grid Margin="{StaticResource ListPageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Margin="0,8,0,0"
                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="DirtyText" x:Uid="Playlist_Unsaved" VerticalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed"
                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
        </StackPanel>

        <!-- 操作: 再生 / シャッフル / 曲を追加 / 上へ / 下へ / 削除 / 保存 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="{StaticResource ControlRowSpacing}" Margin="0,0,0,8">
            <Button Style="{StaticResource AccentButtonStyle}" Click="PlayButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                    <TextBlock x:Uid="Detail_PlayAll" />
                </StackPanel>
            </Button>
            <Button Click="ShuffleButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                    <TextBlock x:Uid="Detail_Shuffle" />
                </StackPanel>
            </Button>
            <AppBarSeparator />
            <Button Click="AddFilesButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock x:Uid="Playlist_AddFiles" />
                </StackPanel>
            </Button>
            <Button x:Name="MoveUpButton" Click="MoveUpButton_Click">
                <FontIcon Glyph="&#xE74A;" FontSize="14" />
            </Button>
            <Button x:Name="MoveDownButton" Click="MoveDownButton_Click">
                <FontIcon Glyph="&#xE74B;" FontSize="14" />
            </Button>
            <Button x:Name="RemoveButton" Click="RemoveButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                    <TextBlock x:Uid="Playlist_Remove" />
                </StackPanel>
            </Button>
            <!-- 自動保存がオンのときは区切りと「保存」ボタンを隠す -->
            <AppBarSeparator x:Name="SaveSeparator" />
            <Button x:Name="SaveButton" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" Click="SaveButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74E;" FontSize="14" />
                    <TextBlock x:Uid="Button_Save" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- ドラッグで並べ替え可能。エクスプローラーから音楽ファイルをドロップしても追加できる。Ctrl+Z / Ctrl+Y で元に戻す・やり直し -->
        <!-- 見出し（上）と一覧（下）。見出しは一覧の外に置くので、スクロールしても上に残る -->
        <Grid x:Name="EntriesPanel" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- 見出し: 押すとその列で並べ替え（もう一度押すと昇順／降順を切り替え）。列幅は一覧の行と同じにする -->
            <Grid x:Name="EntriesHeader" Padding="12,0,12,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource TrackRowArtColumnWidth}" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="56" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Tag="Name" Style="{StaticResource ColumnHeaderButtonStyle}">
                    <TextBlock x:Uid="Column_Title" Style="{StaticResource ListSecondaryTextStyle}" />
                </Button>
                <Button Grid.Column="2" Tag="Artist" Style="{StaticResource ColumnHeaderButtonStyle}">
                    <TextBlock x:Uid="Column_Artist" Style="{StaticResource ListSecondaryTextStyle}" />
                </Button>
                <Button Grid.Column="3" Tag="Album" Style="{StaticResource ColumnHeaderButtonStyle}">
                    <TextBlock x:Uid="Column_Album" Style="{StaticResource ListSecondaryTextStyle}" />
                </Button>
                <Button Grid.Column="4" Tag="Format" Style="{StaticResource ColumnHeaderButtonStyle}">
                    <TextBlock x:Uid="Column_Format" Style="{StaticResource ListSecondaryTextStyle}" />
                </Button>
                <Button Grid.Column="5" Tag="Added" Style="{StaticResource ColumnHeaderButtonStyle}">
                    <TextBlock x:Uid="Column_Added" Style="{StaticResource ListSecondaryTextStyle}" />
                </Button>
                <Button Grid.Column="6" Tag="Duration" Style="{StaticResource ColumnHeaderButtonStyle}">
                    <TextBlock x:Uid="Column_Time" Style="{StaticResource ListSecondaryTextStyle}" />
                </Button>
            </Grid>
            <ListView x:Name="EntriesList" Grid.Row="1" ItemContainerStyle="{StaticResource TrackListItemStyle}" SelectionMode="Extended"
                      CanReorderItems="True" CanDragItems="True" AllowDrop="True"
                      DragOver="EntriesList_DragOver" Drop="EntriesList_Drop"
                      DragItemsStarting="EntriesList_DragItemsStarting" DragItemsCompleted="EntriesList_DragItemsCompleted"
                      IsDoubleTapEnabled="True" DoubleTapped="EntriesList_DoubleTapped"
                      SelectionChanged="EntriesList_SelectionChanged">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- KeepScrollOffset: 並べ替えで項目が動いてもスクロール位置を変えない（既定だと少し下へずれる） -->
                        <ItemsStackPanel ItemsUpdatingScrollMode="KeepScrollOffset" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:PlaylistEntry">
                        <Border Style="{StaticResource TrackRowBorderStyle}">
                            <Grid ColumnSpacing="12" Height="{StaticResource TrackRowHeight}" Opacity="{x:Bind RowOpacity}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource TrackRowArtColumnWidth}" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <!-- 左端: 曲のジャケット（表示された行だけ非同期で読み込む） -->
                                <controls:TrackArt TrackPath="{x:Bind Track.Path}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Track.DisplayTitle}" Style="{StaticResource ListPrimaryTextStyle}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Track.DisplayArtist}" Style="{StaticResource ListSecondaryTextStyle}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Track.DisplayAlbum}" Style="{StaticResource ListSecondaryTextStyle}" />
                                <TextBlock Grid.Column="4" Text="{x:Bind Track.Format}" Style="{StaticResource ListSecondaryTextStyle}" />
                                <TextBlock Grid.Column="5" Text="{x:Bind Track.AddedText}" Style="{StaticResource ListSecondaryTextStyle}" />
                                <TextBlock Grid.Column="6" Text="{x:Bind Track.DurationText}" Style="{StaticResource ListSecondaryTextStyle}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
        <ProgressRing x:Name="LoadingRing" Grid.Row="2" IsActive="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Page>
