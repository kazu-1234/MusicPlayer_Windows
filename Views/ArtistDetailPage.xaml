<Page
    x:Class="MusicPlayer.Views.ArtistDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MusicPlayer.Models"
    xmlns:controls="using:MusicPlayer.Controls">
    <Grid Margin="{StaticResource ListPageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,20,0,8" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="120" Height="120" CornerRadius="60" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                <TextBlock x:Name="InitialText" FontSize="44" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                <TextBlock x:Name="NameText" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock x:Name="InfoText" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource ControlRowSpacing}" Margin="0,12,0,0">
                    <Button Style="{StaticResource AccentButtonStyle}" Click="PlayButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                            <TextBlock x:Uid="Detail_PlayAll" />
                        </StackPanel>
                    </Button>
                    <Button Click="ShuffleButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                            <TextBlock x:Uid="Detail_Shuffle" />
                        </StackPanel>
                    </Button>
                    <!-- 並べ替え（アルバム／曲の表示中の方に効く。設定はライブラリと共通） -->
                    <DropDownButton x:Name="SortButton" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <SelectorBar x:Name="ViewSelector" Grid.Row="1" SelectionChanged="ViewSelector_SelectionChanged">
            <SelectorBarItem x:Name="AlbumsTab" x:Uid="Library_Albums" Tag="Albums" IsSelected="True" />
            <SelectorBarItem x:Name="SongsTab" x:Uid="Library_Songs" Tag="Songs" />
        </SelectorBar>

        <GridView x:Name="AlbumsGrid" Grid.Row="2" SelectionMode="None" IsItemClickEnabled="True"
                  ItemClick="AlbumsGrid_ItemClick" ContainerContentChanging="AlbumsGrid_ContainerContentChanging">
            <!-- 頭文字（または年・追加月）ごとの見出し。中身はコードで CollectionViewSource（グループ付き）にして渡す -->
            <GridView.GroupStyle>
                <GroupStyle HeaderTemplate="{StaticResource LetterGroupHeaderTemplate}" />
            </GridView.GroupStyle>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:Album">
                    <StackPanel Width="168" Padding="4,4,4,8" Spacing="2">
                        <Grid Width="160" Height="160">
                            <Border Style="{StaticResource ArtPlaceholderBorderStyle}">
                                <FontIcon Glyph="&#xE93C;" FontSize="40" Opacity="0.5" />
                            </Border>
                            <Border CornerRadius="6">
                                <Image Source="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
                            </Border>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6"
                                    Padding="6,1" CornerRadius="4"
                                    Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}">
                                <TextBlock Text="{x:Bind Format}" FontSize="11" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,6,0,0" />
                        <TextBlock Text="{x:Bind YearText}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- 見出し（上）と一覧（下）。見出しは一覧の外に置くので、スクロールしても上に残る -->
        <Grid x:Name="SongsPanel" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- 見出し: 押すとその列で並べ替え（もう一度押すと昇順／降順を切り替え）。列幅は一覧の行と同じにする -->
            <Grid x:Name="SongsHeader" Padding="12,0,12,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource TrackRowArtColumnWidth}" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="56" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Tag="Name" Style="{StaticResource ColumnHeaderButtonStyle}">
                    <TextBlock x:Uid="Column_Title" Style="{StaticResource ListSecondaryTextStyle}" />
                </Button>
                <Button Grid.Column="2" Tag="Album" Style="{StaticResource ColumnHeaderButtonStyle}">
                    <TextBlock x:Uid="Column_Album" Style="{StaticResource ListSecondaryTextStyle}" />
                </Button>
                <Button Grid.Column="3" Tag="Format" Style="{StaticResource ColumnHeaderButtonStyle}">
                    <TextBlock x:Uid="Column_Format" Style="{StaticResource ListSecondaryTextStyle}" />
                </Button>
                <Button Grid.Column="4" Tag="Added" Style="{StaticResource ColumnHeaderButtonStyle}">
                    <TextBlock x:Uid="Column_Added" Style="{StaticResource ListSecondaryTextStyle}" />
                </Button>
                <Button Grid.Column="5" Tag="Duration" Style="{StaticResource ColumnHeaderButtonStyle}">
                    <TextBlock x:Uid="Column_Time" Style="{StaticResource ListSecondaryTextStyle}" />
                </Button>
            </Grid>
            <ListView x:Name="SongsList" Grid.Row="1" ItemContainerStyle="{StaticResource TrackListItemStyle}" SelectionMode="Extended"
                      IsDoubleTapEnabled="True" DoubleTapped="SongsList_DoubleTapped">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- KeepScrollOffset: 並べ替えで項目が動いてもスクロール位置を変えない（既定だと少し下へずれる） -->
                        <ItemsStackPanel ItemsUpdatingScrollMode="KeepScrollOffset" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Track">
                        <Border Style="{StaticResource TrackRowBorderStyle}">
                            <Grid ColumnSpacing="12" Height="{StaticResource TrackRowHeight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource TrackRowArtColumnWidth}" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <!-- 左端: 曲のジャケット（表示された行だけ非同期で読み込む） -->
                                <controls:TrackArt TrackPath="{x:Bind Path}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind DisplayTitle}" Style="{StaticResource ListPrimaryTextStyle}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind DisplayAlbum}" Style="{StaticResource ListSecondaryTextStyle}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Format}" Style="{StaticResource ListSecondaryTextStyle}" />
                                <TextBlock Grid.Column="4" Text="{x:Bind AddedText}" Style="{StaticResource ListSecondaryTextStyle}" />
                                <TextBlock Grid.Column="5" Text="{x:Bind DurationText}" Style="{StaticResource ListSecondaryTextStyle}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
