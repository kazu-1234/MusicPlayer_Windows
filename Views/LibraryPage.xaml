<Page
    x:Class="MusicPlayer.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:MusicPlayer.Models"
    xmlns:controls="using:MusicPlayer.Controls"
    NavigationCacheMode="Required">
    <!-- NavigationCacheMode=Required: アルバム詳細から戻ったときにスクロール位置と表示を保つ -->
    <Grid Margin="{StaticResource ListPageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Uid="Page_Library" Style="{StaticResource PageTitleTextStyle}" />

        <!-- 表示切替 / 走査状況 / 形式フィルタ / 検索 / 全曲シャッフル / 再スキャン -->
        <Grid Grid.Row="1" Margin="0,0,0,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <SelectorBar x:Name="ViewSelector" SelectionChanged="ViewSelector_SelectionChanged">
                <SelectorBarItem x:Name="SongsTab" x:Uid="Library_Songs" Tag="Songs" />
                <SelectorBarItem x:Name="AlbumsTab" x:Uid="Library_Albums" Tag="Albums" />
                <SelectorBarItem x:Name="ArtistsTab" x:Uid="Library_Artists" Tag="Artists" />
            </SelectorBar>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Spacing="{StaticResource ControlRowSpacing}">
                <StackPanel x:Name="ScanPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed" VerticalAlignment="Center">
                    <ProgressRing IsActive="True" Width="16" Height="16" />
                    <TextBlock x:Name="ScanText" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                </StackPanel>
                <!-- 並べ替え（名前・追加日など＋昇順／降順）。メニューは表示中の一覧に合わせてコードで作る -->
                <DropDownButton x:Name="SortButton" />
                <!-- 形式フィルタ。ライブラリに複数の形式が混ざっているときだけ表示する -->
                <ComboBox x:Name="FormatCombo" MinWidth="110" Visibility="Collapsed" SelectionChanged="FormatCombo_SelectionChanged" />
                <AutoSuggestBox x:Name="SearchBox" x:Uid="Library_Search" Width="220" QueryIcon="Find"
                                TextChanged="SearchBox_TextChanged" />
                <Button x:Name="ShuffleAllButton" Click="ShuffleAllButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                        <TextBlock x:Uid="Library_ShuffleAll" />
                    </StackPanel>
                </Button>
                <Button x:Name="RescanButton" Click="RescanButton_Click">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 曲一覧 -->
        <!-- 見出し（上）と一覧（下）。見出しは一覧の外に置くので、スクロールしても上に残る -->
        <Grid x:Name="SongsPanel" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- 見出し: 押すとその列で並べ替え（もう一度押すと昇順／降順を切り替え）。列幅は一覧の行と同じにする -->
            <Grid x:Name="SongsHeader" Padding="12,0,12,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource TrackRowArtColumnWidth}" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="56" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Tag="Name" Style="{StaticResource ColumnHeaderButtonStyle}">
                    <TextBlock x:Uid="Column_Title" Style="{StaticResource ListSecondaryTextStyle}" />
                </Button>
                <Button Grid.Column="2" Tag="Artist" Style="{StaticResource ColumnHeaderButtonStyle}">
                    <TextBlock x:Uid="Column_Artist" Style="{StaticResource ListSecondaryTextStyle}" />
                </Button>
                <Button Grid.Column="3" Tag="Album" Style="{StaticResource ColumnHeaderButtonStyle}">
                    <TextBlock x:Uid="Column_Album" Style="{StaticResource ListSecondaryTextStyle}" />
                </Button>
                <Button Grid.Column="4" Tag="Format" Style="{StaticResource ColumnHeaderButtonStyle}">
                    <TextBlock x:Uid="Column_Format" Style="{StaticResource ListSecondaryTextStyle}" />
                </Button>
                <Button Grid.Column="5" Tag="Added" Style="{StaticResource ColumnHeaderButtonStyle}">
                    <TextBlock x:Uid="Column_Added" Style="{StaticResource ListSecondaryTextStyle}" />
                </Button>
                <Button Grid.Column="6" Tag="Duration" Style="{StaticResource ColumnHeaderButtonStyle}">
                    <TextBlock x:Uid="Column_Time" Style="{StaticResource ListSecondaryTextStyle}" />
                </Button>
            </Grid>
            <ListView x:Name="SongsList" Grid.Row="1" ItemContainerStyle="{StaticResource TrackListItemStyle}" SelectionMode="Extended"
                      IsDoubleTapEnabled="True" DoubleTapped="SongsList_DoubleTapped">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- KeepScrollOffset: 並べ替えで項目が動いてもスクロール位置を変えない（既定だと少し下へずれる） -->
                        <ItemsStackPanel ItemsUpdatingScrollMode="KeepScrollOffset" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Track">
                        <Border Style="{StaticResource TrackRowBorderStyle}">
                            <Grid ColumnSpacing="12" Height="{StaticResource TrackRowHeight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource TrackRowArtColumnWidth}" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <!-- 左端: 曲のジャケット（表示された行だけ非同期で読み込む） -->
                                <controls:TrackArt TrackPath="{x:Bind Path}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind DisplayTitle}" Style="{StaticResource ListPrimaryTextStyle}" />
                                <controls:LinkText Grid.Column="2" Text="{x:Bind DisplayArtist}" TextStyle="{StaticResource ListSecondaryTextStyle}" Click="ArtistLink_Click" />
                                <controls:LinkText Grid.Column="3" Text="{x:Bind DisplayAlbum}" TextStyle="{StaticResource ListSecondaryTextStyle}" Click="AlbumLink_Click" />
                                <TextBlock Grid.Column="4" Text="{x:Bind Format}" Style="{StaticResource ListSecondaryTextStyle}" />
                                <TextBlock Grid.Column="5" Text="{x:Bind AddedText}" Style="{StaticResource ListSecondaryTextStyle}" />
                                <TextBlock Grid.Column="6" Text="{x:Bind DurationText}" Style="{StaticResource ListSecondaryTextStyle}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- アルバム（ジャケットのグリッド） -->
        <GridView x:Name="AlbumsGrid" Grid.Row="2" SelectionMode="None" IsItemClickEnabled="True"
                  ItemClick="AlbumsGrid_ItemClick" ContainerContentChanging="AlbumsGrid_ContainerContentChanging"
                  RightTapped="AlbumsGrid_RightTapped" Visibility="Collapsed">
            <!-- 頭文字（または年・追加月）ごとの見出し。中身はコードで CollectionViewSource（グループ付き）にして渡す -->
            <GridView.GroupStyle>
                <GroupStyle HeaderTemplate="{StaticResource LetterGroupHeaderTemplate}" />
            </GridView.GroupStyle>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:Album">
                    <StackPanel Width="168" Padding="4,4,4,8" Spacing="2">
                        <Grid Width="160" Height="160">
                            <Border Style="{StaticResource ArtPlaceholderBorderStyle}">
                                <FontIcon Glyph="&#xE93C;" FontSize="40" Opacity="0.5" />
                            </Border>
                            <Border CornerRadius="6">
                                <Image Source="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
                            </Border>
                            <!-- 形式バッジ（FLAC / MP3 / WAV） -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6"
                                    Padding="6,1" CornerRadius="4"
                                    Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}">
                                <TextBlock Text="{x:Bind Format}" FontSize="11" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,6,0,0" />
                        <TextBlock Text="{x:Bind Artist}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- アーティスト -->
        <GridView x:Name="ArtistsGrid" Grid.Row="2" SelectionMode="None" IsItemClickEnabled="True"
                  ItemClick="ArtistsGrid_ItemClick" RightTapped="ArtistsGrid_RightTapped" Visibility="Collapsed">
            <!-- 頭文字（または年・追加月）ごとの見出し。中身はコードで CollectionViewSource（グループ付き）にして渡す -->
            <GridView.GroupStyle>
                <GroupStyle HeaderTemplate="{StaticResource LetterGroupHeaderTemplate}" />
            </GridView.GroupStyle>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:Artist">
                    <StackPanel Width="168" Padding="4,4,4,8" Spacing="2">
                        <Border Width="140" Height="140" CornerRadius="70" HorizontalAlignment="Center"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <TextBlock Text="{x:Bind Initial}" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        <TextBlock Text="{x:Bind SummaryText}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <TextBlock x:Name="EmptyText" Grid.Row="2" x:Uid="Library_Empty" Visibility="Collapsed"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</Page>
